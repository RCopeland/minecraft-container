# Minecraft Bedrock Dedicated Server
# ---------------------------------------------------------------
# The server runs on the host network and listens on UDP 19132.
# Players connect to the homelab's LAN address, e.g. 192.168.4.37:19132.
# No Tailscale is involved -- see README.md for why.

# Mojang requires accepting the EULA before the server will start.
EULA=TRUE

# Server identity shown to players, and kid-friendly defaults.
SERVER_NAME=Copeland Family Minecraft
GAMEMODE=survival
DIFFICULTY=normal
ALLOW_CHEATS=false

# Online mode = real Xbox Live authentication, so players can't spoof names.
ONLINE_MODE=true

# Transport protocol. MUST stay "raknet".
# Bedrock 1.26.50+ ships transport=nethernet by default, which is a known Mojang
# regression (BDS-23108): the server logs "Accepting clients on 19132" but never
# opens the UDP socket, and every client times out. raknet is the stable
# transport and what Bedrock clients expect on UDP 19132.
TRANSPORT=raknet

# The Bedrock server image defaults its allow list to enabled with no entries,
# which locks everyone out. Access is controlled by ONLINE_MODE instead, so this
# stays false. Set to true only if you want a strict per-player allowlist.
ALLOW_LIST=false

# Timezone
TZ=America/New_York
