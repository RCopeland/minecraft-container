# Minecraft: Java Edition server with Bedrock crossplay
# ---------------------------------------------------------------
# Runs on the host network. Two ways in, same world:
#
#   Java clients    -> <homelab-lan-ip>:25565   (e.g. 192.168.4.37:25565)
#   Bedrock clients -> <homelab-lan-ip>:19132   (iPads, Windows Bedrock)
#
# The kids' iPads are on the home wifi, so no Tailscale is needed on them.
# See README.md for why this is not a tailnet-only stack.

# Mojang requires accepting the EULA before the server will start.
EULA=TRUE

# --- Server version -------------------------------------------------
# MUST stay 26.2.
# Geyser (which lets the iPads join) emulates a Java 26.2 client, and Paper
# 26.2 is the current STABLE build. Paper 26.3 is still BETA and Geyser cannot
# bridge to it yet. A newer Java client joins via the ViaVersion plugin, which
# is included automatically.
MINECRAFT_VERSION=26.2

# --- Identity -------------------------------------------------------
SERVER_NAME=Copeland Family Minecraft
MOTD=Copeland Family Minecraft - Java + Bedrock welcome!

# --- Gameplay (kid-friendly defaults) -------------------------------
GAMEMODE=survival
DIFFICULTY=normal
ALLOW_CHEATS=false
VIEW_DISTANCE=10
MAX_PLAYERS=10

# true = players authenticate via Xbox Live / Mojang, so names cannot be
# spoofed. Floodgate (installed automatically) lets Bedrock players join
# without owning a Java account.
ONLINE_MODE=true

# --- Resources ------------------------------------------------------
# The homelab has ~14GB RAM total with ~6.7GB free.
MEMORY=3G

# --- Ports ----------------------------------------------------------
# These are the defaults and only matter if you need to change them.
GEYSER_PORT=19132

# --- Misc -----------------------------------------------------------
TZ=America/New_York
