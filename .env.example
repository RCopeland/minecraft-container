# Tailscale node auth key — generate one in the Tailscale admin console
# (Access controls -> Keys -> Generate auth key). Reusable/auth-node keys work.
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxx

# MagicDNS name of the app on your tailnet (hostname: minecraft in compose.yaml)
# Pre-filled for reference; this UDP-only stack does not use HTTPS/serve.
TS_CERT_DOMAIN=minecraft.tail4fde5e.ts.net

# Minecraft Bedrock Dedicated Server
# Mojang requires accepting the EULA before the server will start.
EULA=TRUE

# Server identity shown to players, and kid-friendly defaults.
SERVER_NAME=Copeland Family Minecraft
GAMEMODE=survival
DIFFICULTY=normal
ALLOW_CHEATS=false

# Online mode = real Xbox Live authentication, so players can't spoof names.
ONLINE_MODE=true

# Timezone
TZ=America/New_York
