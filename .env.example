# Tailscale node auth key — generate one in the Tailscale admin console
# (Access controls -> Keys -> Generate auth key). Reusable/auth-node keys work.
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxx

# MagicDNS name of the app on your tailnet (hostname: minecraft in compose.yaml)
# Pre-filled for reference; this UDP-only stack does not use HTTPS/serve.
TS_CERT_DOMAIN=minecraft.tail4fde5e.ts.net

# Minecraft Bedrock Dedicated Server
# Mojang requires accepting the EULA before the server will start.
EULA=TRUE

# Server identity shown to players, and kid-friendly defaults.
SERVER_NAME=Copeland Family Minecraft
GAMEMODE=survival
DIFFICULTY=normal
ALLOW_CHEATS=false

# Online mode = real Xbox Live authentication, so players can't spoof names.
ONLINE_MODE=true

# The Bedrock server image defaults its allow list to enabled with no entries,
# which locks everyone out. Access is controlled by ONLINE_MODE instead, so this
# stays false. Set to true only if you want a strict per-player allowlist.
ALLOW_LIST=false

# iOS RakNet MTU discovery fix (see sidecar-entrypoint.sh). iOS Bedrock clients
# cannot report their effective MTU through the Tailscale app, so the sidecar
# pins the shared network interface MTU. Leave these at the defaults unless
# you have a reason to change them.
MTU_INTERFACE=eth0
MTU_VALUE=1280

# Timezone
TZ=America/New_York
